# Core backend env vars used by existing app
REACT_APP_API_URL=http://localhost:5000
REACT_APP_VAPID_PUBLIC_KEY=replace_with_public_key
REACT_APP_GOOGLE_MAPS_API_KEY=replace_with_key

# Supabase Auth (React + Supabase JS)
# Local: create `frontend/.env` from this file and fill values from your Supabase project settings.
# Vercel: Project Settings -> Environment Variables -> add both keys below, then redeploy.
# Render: Service -> Environment -> Environment Variables -> add both keys below, then redeploy.
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_public_anon_key

# Run commands:
# 1) cd frontend
# 2) npm install
# 3) npm start
